# Browser runner for battery steps 2 (Oracle --ui suite) and 7: Chromium + Playwright + pytest.
FROM mcr.microsoft.com/playwright/python:v1.55.0-noble
RUN pip install --no-cache-dir --break-system-packages playwright==1.55.0 pytest==8.4.2 || pip install --no-cache-dir playwright==1.55.0 pytest==8.4.2
